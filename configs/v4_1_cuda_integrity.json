{
  "experiment_version": "v4.1-integrity",
  "output_dir": "artifacts/v4_1_integrity",
  "device": "cuda",
  "require_cuda": true,
  "seed": 2,
  "pool_size": 128,
  "batch_size": 16,
  "training_steps": 20,
  "learning_rate": 0.0001,
  "gradient_clip": 0.0,
  "action_regularization": 0.0,
  "loss_kind": "softplus_progress",
  "progress_tau": 0.95,
  "bootstrap_actions": 8,
  "bootstrap_orthogonal": true,
  "history_capacity": 16,
  "log_every": 10,
  "checkpoint_every": 10,
  "gate_step": 10,
  "gate_episodes": 16,
  "gate_median_q_max": 100.0,
  "gate_endpoint_ratio_max": 100.0,
  "evaluation_episodes": 8,
  "intervention_episodes": 8,
  "fixed_eta_calibration_worlds": 64
}
