{
  "seed": 30,
  "device": "cuda",
  "require_cuda": true,
  "output_dir": "runs/v3_0_bayesian",
  "tasks": {
    "support_sizes": [2, 4, 8, 16],
    "sensor_centers": [-1.5, -0.75, 0.0, 0.75, 1.5],
    "sensor_width": 0.03,
    "observation_noise": 0.25,
    "likelihood_noise": 0.25,
    "train_sequence_length": 6,
    "evaluation_sequence_length": 12
  },
  "gate": {
    "seed": 3001,
    "episodes_per_k": 384,
    "pair_samples": 24000,
    "probe_size": 128,
    "minimum_incremental_history_r2": 0.05,
    "minimum_alias_prevalence": 0.05,
    "minimum_nearest_teacher_ratio": 0.35
  },
  "operator": {
    "dimension": 32,
    "action_dimension": 12,
    "hidden_dimension": 96,
    "basis_depth": 2,
    "projection_ridge": 0.0001
  },
  "phase_a": {
    "steps": 3000,
    "batch_size": 24,
    "probe_size": 96,
    "learning_rate": 0.002,
    "conditioning_weight": 0.05,
    "phi_weight": 0.00001,
    "span_threshold": 0.20,
    "validation_episodes": 256,
    "log_every": 100
  },
  "phase_b": {
    "steps": 5000,
    "batch_size": 8,
    "rollout_max": 6,
    "variable_rollout": true,
    "probe_size": 64,
    "model_dimension": 64,
    "learning_rate": 0.001,
    "action_metric": "functional",
    "lambda_functional": 0.25,
    "gradient_clip": 1.0,
    "log_every": 100
  },
  "evaluation": {
    "episodes_per_cell": 64,
    "query_size": 256,
    "rollout_steps": 8,
    "extended_rollout_steps": 12,
    "seeds": [11, 23, 47]
  }
}
